{
  "name": "kafkajs-next",
  "version": "0.1.0",
  "description": "TypeScript-first Kafka client with schema validation, TypeScript consumer groups, and zero-config monitoring",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test && npm run lint"
  },
  "keywords": ["kafka", "kafkajs", "typescript", "consumer", "producer", "schema-registry", "avro", "protobuf"],
  "author": "AIONEXT <aionext@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AIONEXT/kafkajs-next.git"
  },
  "bugs": {
    "url": "https://github.com/AIONEXT/kafkajs-next/issues"
  },
  "homepage": "https://github.com/AIONEXT/kafkajs-next#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "zod": "^3.22.4",
    "pino": "^8.17.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}